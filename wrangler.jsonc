{
  "name": "stillwallet",
  "main": "server/cloudflare.mjs",
  "compatibility_date": "2026-11-21",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "STILL_RPC_BASE": "https://base-rpc.publicnode.com/",
    "STILL_RPC_XRP": "https://honeycluster.io/",
    "STILL_WALLETCONNECT_PROJECT_ID": "f19623d85205c8afe7e5a93add01f97f"
  },
  "ratelimits": [
    { "name": "API_LIMIT", "namespace_id": "1001", "simple": { "limit": 1200, "period": 60 } },
    { "name": "PRICE_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "MONERO_LIMIT", "namespace_id": "1003", "simple": { "limit": 600, "period": 60 } }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
