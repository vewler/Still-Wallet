{
  "name": "stillwallet",
  "main": "server/cloudflare.mjs",
  "compatibility_date": "2026-11-21",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "STILL_RPC_BASE": "https://base-rpc.publicnode.com/",
    "STILL_RPC_XRP": "https://honeycluster.io/"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
