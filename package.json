{
  "name": "still",
  "version": "0.1.0",
  "description": "Still, a privacy-first non-custodial wallet by ow2",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:phone": "vite --mode phone --host 0.0.0.0 --port 5443 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server/start.ts",
    "check": "tsc --noEmit",
    "test": "node --test scripts/wallet.test.mjs"
  },
  "author": "ow2",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "@scure/btc-signer": "^2.4.1",
    "@solana-program/system": "^0.16.0",
    "@solana-program/token": "^0.18.0",
    "@solana/kit": "^8.6.0",
    "@solana/rpc-spec-types": "^8.6.0",
    "lucide-react": "^1.75.0",
    "monero-ts": "^0.11.22",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ripple-address-codec": "^5.0.1",
    "ripple-binary-codec": "^2.11.0",
    "ripple-keypairs": "^3.1.0",
    "viem": "^2.58.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0"
  }
}
