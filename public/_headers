/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https: wss://relay.walletconnect.org wss://relay.walletconnect.com http://localhost:* http://127.0.0.1:*; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Resource-Policy: same-origin
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  ! Content-Security-Policy
  ! X-Frame-Options
  ! Cross-Origin-Opener-Policy
  ! Permissions-Policy
  ! Referrer-Policy
  ! X-Content-Type-Options
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin
/apple-touch-icon*
  ! Content-Security-Policy
  ! X-Frame-Options
  ! Cross-Origin-Opener-Policy
  ! Permissions-Policy
  ! Referrer-Policy
  ! X-Content-Type-Options
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin
/favicon.ico
  ! Content-Security-Policy
  ! X-Frame-Options
  ! Cross-Origin-Opener-Policy
  ! Permissions-Policy
  ! Referrer-Policy
  ! X-Content-Type-Options
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin
/manifest.webmanifest
  ! Content-Security-Policy
  ! X-Frame-Options
  ! Cross-Origin-Opener-Policy
  ! Permissions-Policy
  ! Referrer-Policy
  ! X-Content-Type-Options
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin
